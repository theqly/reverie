enum AccessLevelType {
  private
  public
  group
  group_public
}

enum OwnerType {
  user
  group
}

type Board {
  id: UUID!
  name: String!
  description: String
  accessLevel: AccessLevelType!
  ownerId: UUID!
  authorId: UUID!
  ownerType: OwnerType!
  createdAt: Time!
  savedAt: Time!
  pins: [Pin!]

  reactionId: UUID
  bookmarked: Boolean
}

type CommentToBoard {
  id: UUID!
  boardId: UUID!
  message: String!
  createdAt: Time!
  owner: User!
}