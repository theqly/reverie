type Pin @key(fields: "id") {
  id: UUID!
  name: String!
  owner: User!
  address: String
  latitude: Float!
  longitude: Float!
  description: String
  rating: Float!
  createdAt: Time!
  place: Place
  
  images: [PinImage!]
  # comments: [Comment!]
}

type PinImage {
  id: UUID!
  orderNumber: Int!
  imageUrl: String!
}

type Comment {
  id: UUID!
  content: String!
  createdAt: Time!
  author: User!
}