extend schema
@link(url: "https://specs.apollo.dev/federation/v2.7", import: ["@key"])

type Query {
  placeInfo(point: PointInput!, params: CommonParams): [PlaceData!]!
}

input CommonParams {
  locale: String
  kind: String
  resultsQ: Int
}

input PointInput {
  lat: Float!
  lon: Float!
}

type Point {
  lat: Float!
  lon: Float!
}

type PlaceData @key(fields: "lat lon") {
  id: String!
  lat: Float!
  lon: Float!
  kind: String!
  descr: String!
  addr: String!
}
